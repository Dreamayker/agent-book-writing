      "purl": "pkg:maven/org.springframework/spring-webmvc@6.2.19?type=jar",
      "status": "not_affected",
      "review_by": "2026-12-05",
      "reason": "Source inspection: OrderController exposes JSON REST methods only. There is no SseEmitter, FragmentsRendering, SSE stream or fragment view rendering. The advisory requires streaming rendered HTML fragments. This assessment must be revisited before adding view or SSE endpoints.",
