}],"type":"p","id":"tO-BfJAe3G"}],"id":"zrGRgsJYCd"},{"type":"td","children":[{"children":[{"text":"路由决策、启动的角色、采用的配置"}],"type":"p","id":"4qSf7pSsCv"}],"id":"Q0T_SpnRrP"},{"type":"td","children":[{"children":[{"text":"审计\"为什么走这条路\""}],"type":"p","id":"riMaDaL01n"}],"id":"_yrk_xHzEq"}],"id":"iCg4Bm6NRZ"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"版本元数据"}],"type":"p","id":"BwVPvu7WmD"}],"id":"WWSGpL1VV-"},{"type":"td","children":[{"children":[{"text":"流水线版本、工具版本、模型版本"}],"type":"p","id":"pChhy27ihM"}],"id":"UmqogFx0AU"},{"type":"td","children":[{"children":[{"text":"回放与复现"}],"type":"p","id":"4oY2bWlmY0"}],"id":"h-pkm8bwCC"}],"id":"kFSRDv3kEN"}],"id":"FR0aitwfW0","colSizes":[284.6666666666667,284.6666666666667,284.6666666666667]},{"type":"p","children":[{"text":"教学项目中，证据包落在 "},{"text":"book-assets/<PR>-<场景>/evidence/","code":true},{"text":" 目录："},{"text":"pytest-fail.log","code":true},{"text":"、测试矩阵、"},{"text":"findings.json","code":true},{"text":" 等，与 "},{"text":"make replay-pr04","code":true},{"text":" 命令（9.6.5）配套。"}],"id":"oT0Nq5wjI1"},{"type":"p","children":[{"text":"不可变性有两层保证。第一层是"},{"text":"只追加","bold":true},{"text":"（append-only）：证据包一旦冻结，任何角色不得改写已写入的 Finding，后续只允许追加标注（如仲裁结论\"驳回\"）。第二层是"},{"text":"哈希链","bold":true},{"text":"：每条记录携带前一条记录的摘要，证据包整体可校验——任何一条被篡改，链条断裂，仲裁与评测即拒绝采信。不可变是回放的前提：如果输入可以被事后修改，\"同一输入重演\"就失去意义；不可变也是仲裁的前提：9.8 的裁决者必须确信自己看到的证据就是评审当时产生的证据。"}],"id":"qD5NKxQqB0"},{"type":"h2","children":[{"text":"9.6.4 风险路由：决定走哪条路"}],"id":"XapAjmxrqL"},{"type":"p","children":[{"text":"流水线入口的第一道决策是"},{"text":"风险路由","bold":true},{"text":"（risk routing）：根据变更的元数据与静态信号，决定这次评审走哪条路径。路由规则写在 "},{"text":"policies/risk-rules.yaml","code":true},{"text":"，本身是版本化的代码，而不是提示词："}],"id":"ebSia86AFS"},{"children":[{"children":[{"text":"# 教学模板：风险路由规则（字段以本书实验项目为准）"}],"type":"code_line","id":"nRu0ienD7z"},{"children":[{"text":"route:"}],"type":"code_line","id":"1iFq0mRUjd"},{"children":[{"text":"  - id: RULE-001"}],"type":"code_line","id":"nIQri5stsw"},{"children":[{"text":"    when:"}],"type":"code_line","id":"h4R2W01_X2"},{"children":[{"text":"      path_match: [\"app/repository.py\", \"app/transfer*\"]"}],"type":"code_line","id":"lP98fkRWRW"},{"children":[{"text":"      keyword_hit: [\"balance\", \"amount\", \"owner_id\"]"}],"type":"code_line","id":"uiEesHV-DN"},{"children":[{"text":"    then:"}],"type":"code_line","id":"DpxSkxBF8k"},{"children":[{"text":"      config: hybrid"}],"type":"code_line","id":"aCQkkC3RyD"},{"children":[{"text":"      agents: [correctness, security, testing, impact]"}],"type":"code_line","id":"lPakKT2atI"},{"children":[{"text":"      needs_human: true"}],"type":"code_line","id":"eXaNaL1Gz5"},{"children":[{"text":""}],"type":"code_line","id":"VSmn8O6sQb"},{"children":[{"text":"  - id: RULE-002"}],"type":"code_line","id":"vD8PKHPAXB"},{"children":[{"text":"    when:"}],"type":"code_line","id":"Cv9Ez6Ik3h"},{"children":[{"text":"      path_match: [\"docs/\", \"*.md\"]"}],"type":"code_line","id":"zvnRyLFJMJ"},{"children":[{"text":"      no_behavior_change: true"}],"type":"code_line","id":"knFT0zZNRW"},{"children":[{"text":"    then:"}],"type":"code_line","id":"CJ-hXdu1pj"},{"children":[{"text":"      config: lint_only"}],"type":"code_line","id":"KXWqVzzZON"},{"children":[{"text":"      agents: []"}],"type":"code_line","id":"ob7sULlhWn"},{"children":[{"text":"      needs_human: false"}],"type":"code_line","id":"thGpLxEffW"},{"children":[{"text":""}],"type":"code_line","id":"cIVixmnc-d"},{"children":[{"text":"  - id: RULE-003"}],"type":"code_line","id":"PBZFuzpotY"},{"children":[{"text":"    when:"}],"type":"code_line","id":"NrR31AGxAz"},{"children":[{"text":"      dependency_changed: true"}],"type":"code_line","id":"zrw29tLgMA"},{"children":[{"text":"    then:"}],"type":"code_line","id":"k28jQRPGZK"},{"children":[{"text":"      agents: [security, impact]"}],"type":"code_line","id":"MAdM8TigjD"},{"children":[{"text":"      needs_human: true"}],"type":"code_line","id":"NuL17i6tw9"}],"type":"code_block","lang":"yaml","id":"UDxXwFTRIa"},{"type":"p","children":[{"text":"路由的三个要点。第一，"},{"text":"信号要静态可判","bold":true},{"text":"：命中不变量核心文件（如 "},{"text":"app/repository.py","code":true},{"text":"）或金额、授权关键字，意味着结论可能触发 9.4.2 契约中的 "},{"text":"needs_human","code":true},{"text":" 升级路径——路由在流水线层面提前执行同一规则。第二，"},{"text":"路由决策本身入证据包","bold":true},{"text":"：任何一次评审都能回答\"为什么启动这些角色\"，而非事后补解释。第三，"},{"text":"路由是成本的第一道闸门","bold":true},{"text":"：PR-01 这类文档改动走 "},{"text":"lint_only","code":true},{"text":" 路径，不启动任何专业 Agent——多 Agent 的成本（9.10 展开）只在风险需要时才值得支付。"}],"id":"YVVu8nVbQz"},{"type":"h2","children":[{"text":"9.6.5 调度与可回放执行"}],"id":"egSjNxY6iZ"},{"type":"p","children":[{"text":"路由决定路径，"},{"text":"编排器","bold":true},{"text":"（orchestrator）执行路径：按路由决策启动角色（9.5.5 的串行/并行/混合配置）、按权限矩阵注入最小输入（9.5.4）、收集执行证据、执行 9.6.2 的验收断言、组装并冻结证据包。每一步的\"组件、输入引用、输出、工具版本\"都写入轨迹记录。"}],"id":"NSQCzTGaOs"},{"type":"p","children":[{"text":"可回放性由两个要素保证："}],"id":"WF-Vtg5iUE"},{"indent":1,"listGroup":"RNQX5W","listStyleType":"decimal","type":"p","children":[{"text":"版本锁定","bold":true},{"text":"：证据包记录流水线版本、工具版本与模型版本。"},{"text":"make replay-pr04","code":true},{"text":" 重放时，使用同一版本的确定性组件对同一输入摘要重新执行。"}],"id":"xnoqPv7jYE"},{"indent":1,"listGroup":"RNQX5W","listStart":2,"listStyleType":"decimal","type":"p","children":[{"text":"区分可回放与不可回放","bold":true},{"text":"。测试、lint、依赖扫描是确定性步骤，同一输入重跑结果应当逐字节一致；模型生成 Finding 不是确定性步骤——采样随机性意味着模型不会、也不被承诺逐字复现同样的文字。因此证据包对模型步骤的记录方式是："},{"text":"记录该次运行产出了什么、引用了哪些证据，回放时验证证据引用可解析、Schema 合法、确定性步骤一致","bold":true},{"text":"，而不去验证\"模型再次说出同样的话\"。"}],"id":"lsJBn8Cqgp"},{"type":"p","children":[{"text":"这里必须守住一条事实边界，它在本章反复出现："},{"text":"录制回放不代表真实模型能力","bold":true},{"text":"。"},{"text":"make replay-pr04","code":true},{"text":" 回放的是流水线与证据，不是模型推理；一条 Finding 的\"可复现\"指的是它的证据链可以在不重新询问模型的情况下被验证，而不是模型在相同输入下必然再次发现它。前者是工程事实，后者是能力声明——把两者混为一谈，正是 9.1.2 批评的\"测试通过等于代码正确\"式偷换。"}],"id":"v9xEwUDL8q"},{"type":"h2","children":[{"text":"9.6.6 端到端示例：PR-04 走一遍流水线"}],"id":"3I1m4SgfPf"},{"type":"p","children":[{"text":"把以上机制串起来，看主线案例 PR-04 如何走完流水线（此处只演示骨架，完整教学结构在 9.7 展开）："}],"id":"BJ88I4px9w"},{"children":[{"children":[{"text":"<code>flowchart LR"}],"type":"code_line","id":"lfQu0mwSpO"},{"children":[{"text":"  IN[\"PR-04 Diff\"] --> R[\"风险路由<br/>policies/risk-rules.yaml\"]"}],"type":"code_line","id":"IMJfAU6jJg"},{"children":[{"text":"  R -- \"hybrid + needs_human\" --> A1[\"correctness Agent\"]"}],"type":"code_line","id":"nYsxaIYgJ8"},{"children":[{"text":"  R --> A2[\"security Agent\"]"}],"type":"code_line","id":"oKDrJZ1zlv"},{"children":[{"text":"  R --> A3[\"testing Agent\"]"}],"type":"code_line","id":"O68S1wEtrt"},{"children":[{"text":"  R --> A4[\"impact Agent\"]"}],"type":"code_line","id":"FC0a_HQv0R"},{"children":[{"text":"  ES[\"共享证据库<br/>不变量 / 基线测试 / Oracle\"] -.-> A1"}],"type":"code_line","id":"wxRM5PH8GN"},{"children":[{"text":"  ES -.-> A2"}],"type":"code_line","id":"4-8X2nRi52"},{"children":[{"text":"  A1 --> F1[\"CONCURRENCY-001\"]"}],"type":"code_line","id":"YZHH0mEbhl"},{"children":[{"text":"  A2 --> F2[\"无 AUTHZ 命中\"]"}],"type":"code_line","id":"sEGRPrQuyO"},{"children":[{"text":"  A3 --> F3[\"测试矩阵证据\"]"}],"type":"code_line","id":"hUgFroXk3e"},{"children":[{"text":"  A4 --> F4[\"影响面说明\"]"}],"type":"code_line","id":"OU-tO2nMPo"},{"children":[{"text":"  F1 & F2 & F3 & F4 --> ACC[\"验收断言<br/>evidence_ref 可解析\"]"}],"type":"code_line","id":"c4EjHPprin"},{"children":[{"text":"  ACC --> EP[\"证据包 evidence package<br/>hash 冻结\"]"}],"type":"code_line","id":"tkaEKa3ISk"},{"children":[{"text":"</code>"}],"type":"code_line","id":"mavIdqKaW_"}],"type":"code_block","lang":"mermaid","id":"eHOt12_VRs"},{"type":"p","children":[{"text":"图 9-6 PR-04 的证据流水线轨迹。","bold":true},{"text":" 路由命中 "},{"text":"app/repository.py","code":true},{"text":" 与金额关键字，走混合配置并强制人工；四个角色从共享证据库取证据、产出独立结论；编排器验收后冻结证据包。"}],"id":"0huXdBfxTj"},{"type":"p","children":[{"text":"表 9-10 PR-04 流水线步骤记录","bold":true}],"id":"vH3zZIeNYu"},{"type":"table","children":[{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"步骤","bold":true}],"type":"p","id":"ni9EONT64y"}],"id":"wfJcXBDn_T"},{"type":"td","children":[{"children":[{"text":"组件","bold":true}],"type":"p","id":"jzNRoK13Cd"}],"id":"1L15FbkveJ"},{"type":"td","children":[{"children":[{"text":"输入","bold":true}],"type":"p","id":"STfv9ajZ8c"}],"id":"QNnp5Vuwke"},{"type":"td","children":[{"children":[{"text":"产出","bold":true}],"type":"p","id":"KRcIMcD8yv"}],"id":"azDwZ7p64c"},{"type":"td","children":[{"children":[{"text":"证据","bold":true}],"type":"p","id":"ofptsbO6B3"}],"id":"NVSw7Yypm4"}],"id":"EiPiCz-X_X"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"1 入口登记"}],"type":"p","id":"PGxuAaEOFt"}],"id":"E4ny6tgure"},{"type":"td","children":[{"children":[{"text":"编排器"}],"type":"p","id":"GLpllT5-c1"}],"id":"f0L-Z_8whv"},{"type":"td","children":[{"children":[{"text":"PR-04 Diff"}],"type":"p","id":"gb-4qk0mb4"}],"id":"gy_sNQD3pE"},{"type":"td","children":[{"children":[{"text":"输入摘要"}],"type":"p","id":"bVzy2j0BCc"}],"id":"1KqUaUFuGf"},{"type":"td","children":[{"children":[{"text":"diff hash 记录"}],"type":"p","id":"wwMo5S9uqr"}],"id":"ZgCyvUEMV1"}],"id":"t2BQTn9k_w"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"2 风险路由"}],"type":"p","id":"QuUwX7xaqG"}],"id":"yfigHlGBCN"},{"type":"td","children":[{"children":[{"text":"risk-rules.yaml"}],"type":"p","id":"Z250kTSCuo"}],"id":"94ofENZAEp"},{"type":"td","children":[{"children":[{"text":"路径＋关键字"}],"type":"p","id":"dhBR2ym8VE"}],"id":"c_NFp2fafg"},{"type":"td","children":[{"children":[{"text":"hybrid、全角色、needs_human"}],"type":"p","id":"IqxPsY1UPa"}],"id":"O5b2Cz2r8d"},{"type":"td","children":[{"children":[{"text":"路由记录"}],"type":"p","id":"saPOCfQCKe"}],"id":"yS9gabDDkT"}],"id":"_B0-u4KwYk"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"3 缺陷评审"}],"type":"p","id":"0houhEV-pZ"}],"id":"FudGW5t3J9"},{"type":"td","children":[{"children":[{"text":"correctness Agent"}],"type":"p","id":"SpVf1Ncce4"}],"id":"YQm8T9D9q6"},{"type":"td","children":[{"children":[{"text":"Diff＋调用图＋不变量＋基线测试"}],"type":"p","id":"8LG0GHhM9x"}],"id":"pSCk-g_A_c"},{"type":"td","children":[{"children":[{"text":"CONCURRENCY-001"}],"type":"p","id":"IzyIklAVK8"}],"id":"0DMLh9Uf7N"},{"type":"td","children":[{"children":[{"text":"pytest-fail.log","code":true}],"type":"p","id":"MblCIjodeF"}],"id":"Q0DppU7cxj"}],"id":"JjQAGCYJdR"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"4 测试证据"}],"type":"p","id":"AayiEyG383"}],"id":"ggBQjMRY67"},{"type":"td","children":[{"children":[{"text":"testing Agent"}],"type":"p","id":"uvp5SpCbuo"}],"id":"PVlJgmeG1i"},{"type":"td","children":[{"children":[{"text":"测试矩阵"}],"type":"p","id":"H9_5FNajgo"}],"id":"TcorpUxqGY"},{"type":"td","children":[{"children":[{"text":"并发覆盖缺口说明"}],"type":"p","id":"LaVLWiDfVl"}],"id":"Q29n8aOIY4"},{"type":"td","children":[{"children":[{"text":"测试清单"}],"type":"p","id":"_i5gi5TA70"}],"id":"VDYvCC0eXx"}],"id":"-dvmTkBNZ8"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"5 安全与影响"}],"type":"p","id":"Jsc-8Xdyfw"}],"id":"YPpBRtgHzM"},{"type":"td","children":[{"children":[{"text":"security / impact"}],"type":"p","id":"_wTLqbT2Jr"}],"id":"H1iaWju2r6"},{"type":"td","children":[{"children":[{"text":"授权测试 / 调用图"}],"type":"p","id":"-b8oMj0Y-b"}],"id":"F6U7M-JQ2d"},{"type":"td","children":[{"children":[{"text":"无 AUTHZ 命中；影响限于 transfer 模块"}],"type":"p","id":"hPRYjN1zmd"}],"id":"9a7I48871X"},{"type":"td","children":[{"children":[{"text":"授权回归结果"}],"type":"p","id":"uax2rhvl7t"}],"id":"AxEB3KShTs"}],"id":"h6_Hw5UaAX"},{"type":"tr","children":[{"type":"td","children":[{"children":[{"text":"6 验收冻结"}],"type":"p","id":"F-aQFRZlyi"}],"id":"5Xrp_R4zwF"},{"type":"td","children":[{"children":[{"text":"编排器"}],"type":"p","id":"AFydetVrfn"}],"id":"ldTgOz_9Q1"},{"type":"td","children":[{"children":[{"text":"全部 Finding"}],"type":"p","id":"TfcqYj-EfY"}],"id":"fG_44tXwD6"},{"type":"td","children":[{"children":[{"text":"证据包（hash）"}],"type":"p","id":"s8fQ5KQo7E"}],"id":"rmo98Mq5so"},{"type":"td","children":[{"children":[{"text":"验收断言结果"}],"type":"p","id":"LHDUzDlevc"}],"id":"dXec0pWG9Y"}],"id":"fvUcbTbWyH"}],"id":"dALl-HFAj_","colSizes":[170.8,170.8,170.8,170.8,170.8]},{"type":"p","children":[{"text":"注意第 5 步：security 的\"无命中\"与 impact 的\"影响面说明\"也是证据包的一部分。"},{"text":"\"没发现问题\"和\"发现问题\"一样需要证据","bold":true},{"text":"——没有授权回归结果支撑的\"无 AUTHZ 命中\"只是一句断言，这正是 9.4.3 摘要纪律在流水线层面的体现。冻结后的证据包进入 9.8 的仲裁：人工裁决者看到的是四个独立结论与共享证据，而不是一组互相印证的评论。"}],"id":"GrLWyv4ifb"},{"type":"h2","children":[{"text":"9.6.7 与工业界对照：provenance、CI 产物与审计"}],"id":"U9P76QRgtW"},{"type":"p","children":[{"text":"\"把产物来源变成可验证元数据\"并非评审领域独有。软件供应链安全领域已经为此建立了一整套标准，证据流水线可以从中借到语言和结构。"}],"id":"iMjeHqOeYV"},{"type":"p","children":[{"text":"对照一：SLSA 的 provenance。","bold":true},{"text":" SLSA（Supply-chain Levels for Software Artifacts）把 provenance 定义为\"关于软件工件的可验证信息，描述它在何处、何时、如何被生产\"，用途是让消费者验证工件确实按预期方式构建、并在需要时重建它。其声明结构记录构建模板（buildType）、外部输入参数（externalParameters）、解析后的依赖（resolvedDependencies）、构建平台（builder.id）与产出工件（subject）。证据包是同一思想在评审域的实现：SLSA 回答\"这个二进制怎么来的\"，证据包回答\"这条评审结论怎么来的\"——两者的字段一一对应：buildType 对应流水线定义，externalParameters 对应 PR 输入，resolvedDependencies 对应 Diff 与依赖，builder.id 对应编排器与工具版本。"}],"id":"yY5ZzdGQwr"},{"type":"p","children":[{"text":"对照二：in-toto 的布局与链接元数据。","bold":true},{"text":" in-toto 是保障软件供应链完整性的框架，其核心机制是：项目所有者签署一份"},{"text":"布局","bold":true},{"text":"（layout），列出供应链的步骤序列与每个步骤被授权的执行者（functionary）；执行者完成步骤时生成"},{"text":"链接元数据","bold":true},{"text":"（link metadata），记录所用命令与相关文件，从而建立一条可对照布局验证的连续证据链。布局之于供应链，正如路由规则之于评审流水线；链接元数据之于供应链步骤，正如轨迹记录之于评审步骤。in-toto 论文将其概括为\"收集关于链本身的密码学可验证信息\"——这与证据包的哈希链是同一种信任模型："},{"text":"不信任叙述，只信任带来源、可验证的记录。","bold":true}],"id":"ZluzP-UM_-"},{"type":"p","children":[{"text":"对照三：CI/CD 产物与证据包的差别。","bold":true},{"text":" 主流 CI 系统都会留存构建产物与日志，这属于工程常识，但产物与\"结论\"是分离的：CI 记录\"构建成功/失败\"，不绑定\"为什么得出这个评审结论、依据是什么\"。证据包的一等公民是"},{"text":"结论与证据的绑定关系","bold":true},{"text":"——每条 Finding 必须携带可解析的 evidence_ref。差异源于目标不同：供应链 provenance 防的是攻击者篡改产物；证据包防的是评审自身的失真：漏报、误报、越权、级联幻觉（9.5.3）。两者共同的底线是：凡是影响决策的记录，都必须能够回到源头。"}],"id":"w6OrElDSHS"},{"type":"p","children":[{"text":"事实边界声明：本节对 SLSA 与 in-toto 的描述基于其官方文档与论文摘要；证据包的设计借鉴了二者的结构，但并未实现其签名体系，教学项目中的哈希链是简化示范，不构成对供应链安全标准的实现或认证。"}],"id":"RSLDeSbi-s"},{"type":"h2","children":[{"text":"9.6.8 练习与小结"}],"id":"rOiBu4470k"},{"type":"p","children":[{"text":"9.6 练习","bold":true}],"id":"2eMMllO_Z9"},{"indent":1,"listGroup":"EYoG0G","listStyleType":"decimal","type":"p","children":[{"text":"为 CONCURRENCY-001 补全 "},{"text":"schema_version","code":true},{"text":" 与 "},{"text":"provenance","code":true},{"text":" 字段，说明每个字段支撑哪一条审计需求（可验证/可回放/可审计/可问责）；"}],"id":"dcjN7IjFCy"},{"indent":1,"listGroup":"EYoG0G","listStart":2,"listStyleType":"decimal","type":"p","children":[{"text":"设计一条新的 risk-rules.yaml 规则（信号→配置），并解释为什么路由决策必须写入证据包而不能只存在于编排器日志；"}],"id":"j9qPkkHZx9"},{"indent":1,"listGroup":"EYoG0G","listStart":3,"listStyleType":"decimal","type":"p","children":[{"text":"解释\"回放流水线不等于回放模型\"：确定性步骤与模型步骤在回放时分别验证什么，证据包如何记录两者的差异；"}],"id":"mefrqgiaRA"},{"indent":1,"listGroup":"EYoG0G","listStart":4,"listStyleType":"decimal","type":"p","children":[{"text":"讨论：若证据包哈希校验失败（内容被篡改），流水线应如何反应——拒绝仲裁、强制重审还是告警放行？为什么？"}],"id":"73PQ7mwn5P"},{"type":"p","children":[{"text":"9.6 小结","bold":true},{"text":"：证据流水线把评审从\"输出评论\"改造成\"冻结轨迹\"。Schema 规范化结论（9.6.2），证据包冻结轨迹（9.6.3），风险路由决定路径（9.6.4），编排器执行路径并保证可回放（9.6.5），PR-04 演示了全过程（9.6.6），供应链领域的 provenance 标准提供了同构的工业语言（9.6.7）。至此，本章的\"管线\"已经完整：组件（9.4）、组织（9.5）、轨迹（9.6）。但流水线跑出来的证据包还要经过一个环节才能变成决策——冲突如何仲裁、人工如何治理，这是 9.8 的内容；在此之前，9.7 先用六个真实案例把这条流水线压一遍。"}],"id":"CsExhy0Ok7"},{"type":"hr","children":[{"text":""}],"id":"_TIdvhlpdr"},{"type":"p","children":[{"text":"进度记录","bold":true},{"text":"：已完成 9.1–9.6。待完成：9.7 六案例深度实战、9.8 仲裁与治理、9.9 评测与行业基准、9.10 成本与路由、9.11 安全防御、9.12 端到端演练。图 9-6 与表 9-9、9-10 为章节内部编号，全书统一编号留待审校。"}],"id":"gz0Am09zf2"},{"type":"p","children":[{"text":"本轮引用说明","bold":true},{"text":"：SLSA provenance 官方规范（provenance 定义与字段结构）；in-toto 官方文档（布局、执行者、链接元数据、连续证据链） 与论文摘要（密码学可验证的链信息）。SLSA 字段细节依据本轮读取的 slsa.dev/spec/v1.0/provenance 官方全文。原稿素材（Finding Schema、证据包、risk-rules.yaml、make replay-pr04、book-assets 目录）沿用此前各节口径。"}],"id":"YZI7FF2ZEp"}]