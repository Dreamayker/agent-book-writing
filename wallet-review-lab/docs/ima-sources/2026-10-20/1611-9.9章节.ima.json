    "children": [
      {
        "text": "评测",
        "bold": true
      },
      {
        "text": "：以下为教学简化示例（未声称可直接运行）："
      }
    ],
    "id": "4Z34--C_w9"
  },
  {
    "children": [
      {
        "children": [
          {
            "text": "# evaluation/metrics.py（教学简化示例）"
          }
        ],
        "type": "code_line",
        "id": "fZQ68wNVS-"
      },
      {
        "children": [
          {
            "text": "def dedup_key(f):                      # 稳定去重键，与 9.6.1 去重纪律一致"
          }
        ],
        "type": "code_line",
        "id": "Ek3SeaatTc"
      },
      {
        "children": [
          {
            "text": "    return (f.root_cause, f.file, f.invariant_violated)"
          }
        ],
        "type": "code_line",
        "id": "xMZSaCSVqE"
      },
      {
        "children": [
          {
            "text": ""
          }
        ],
        "type": "code_line",
        "id": "07uUUbfIr-"
      },
      {
        "children": [
          {
            "text": "def score(gold, findings, gate_only_high=True):"
          }
        ],
        "type": "code_line",
        "id": "kndQzTJ0_i"
      },
      {
        "children": [
          {
            "text": "    seen, hits = set(), set()"
          }
        ],
        "type": "code_line",
        "id": "ejpQk25tXk"
      },
      {
        "children": [
          {
            "text": "    for f in findings:"
          }
        ],
        "type": "code_line",
        "id": "8bKmdhbbxK"
      },
      {
        "children": [
          {
            "text": "        k = dedup_key(f)"
          }
        ],
        "type": "code_line",
        "id": "F0FGcM8R6K"
      },
      {
        "children": [
          {
            "text": "        if k in seen:                  # 同根因只计一次"
          }
        ],
        "type": "code_line",
        "id": "ZGjBaETQkU"
      },
      {
        "children": [
          {
            "text": "            continue"
          }
        ],
        "type": "code_line",
        "id": "tvzhqFayuu"
      },
      {
        "children": [
          {
            "text": "        seen.add(k)"
          }
        ],
        "type": "code_line",
        "id": "K-XoQk3CQf"
      },
      {
        "children": [
          {
            "text": "        if k in {g.key for g in gold}: # 命中 Oracle 中的真根因"
          }
        ],
        "type": "code_line",
        "id": "DB4qZPOJjY"
      },
      {
        "children": [
          {
            "text": "            hits.add(k)"
          }
        ],
        "type": "code_line",
        "id": "1lxtu70nhA"
      },
      {
        "children": [
          {
            "text": "    tp = len(hits)"
          }
        ],
        "type": "code_line",
        "id": "MoLn7giT9F"
      },
      {
        "children": [
          {
            "text": "    reported = len(seen)"
          }
        ],
        "type": "code_line",
        "id": "bzySijVfZt"
      },
      {
        "children": [
          {
            "text": "    recall = tp / len(gold)"
          }
        ],
        "type": "code_line",
        "id": "Qr6srVGXE6"
      },
      {
        "children": [
          {
            "text": "    precision = tp / reported if reported else 1.0"
          }
        ],
        "type": "code_line",
        "id": "clL8xfL5iI"
      },
      {
        "children": [
          {
            "text": "    missed_high = [g.key for g in gold"
          }
        ],
        "type": "code_line",
        "id": "dsHbHyae5v"
      },
      {
        "children": [
          {
            "text": "                   if g.severity == \"high\" and g.key not in hits]"
          }
        ],
        "type": "code_line",
        "id": "jbXmrTRZjw"
      },
      {
        "children": [
          {
            "text": "    gate = \"FAIL\" if (gate_only_high and missed_high) else \"PASS\""
          }
        ],
        "type": "code_line",
        "id": "-mcPTU2ZoY"
      },
      {
        "children": [
          {
            "text": "    return {\"precision\": round(precision, 3),"
          }
        ],
        "type": "code_line",
        "id": "MqjuFDHnAE"
      },
      {
        "children": [
          {
            "text": "            \"recall\": round(recall, 3),"
          }
        ],
        "type": "code_line",
        "id": "zEktbYgSbf"
      },
      {
        "children": [
          {
            "text": "            \"zero_defect_gate\": gate,"
          }
        ],
        "type": "code_line",
        "id": "r9kK9Xs3Th"
      },
      {
        "children": [
          {
            "text": "            \"missed_high\": missed_high}"
          }
        ],
        "type": "code_line",
        "id": "0IdHXGoXJ-"
      }
    ],
    "type": "code_block",
    "lang": "python",
    "id": "3d1STzU3K9"
