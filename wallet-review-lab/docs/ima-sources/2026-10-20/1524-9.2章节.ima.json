      {
        "children": [
          {
            "text": "  E --> F[\"LLM 自动代码评审<br/>RADAR Review Agent\"]"
          }
        ],
        "type": "code_line",
        "id": "bWy2Sjktbw"
      },
      {
        "children": [
          {
            "text": "  F --> G[\"确定性验证\"]"
          }
        ],
        "type": "code_line",
