Subject: [PATCH] case: move balance update outside atomic boundary

---
 app/repository.py | 4 ++--
 app/service.py    | 2 ++
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/app/repository.py b/app/repository.py
index b8c42a0..7cdbc60 100644
--- a/app/repository.py
+++ b/app/repository.py
@@ -32,8 +32,8 @@ class InMemoryWalletRepository:
         self._lock = RLock()
 
     def atomic(self, operation: Callable[[], T]) -> T:
-        with self._lock:
-            return operation()
+        # Avoid holding the process-wide lock while repository calls perform I/O.
+        return operation()
 
     def get_wallet(self, wallet_id: UUID) -> Wallet:
         try:
diff --git a/app/service.py b/app/service.py
index 8e48562..4bf9fd5 100644
--- a/app/service.py
+++ b/app/service.py
@@ -1,5 +1,6 @@
 from dataclasses import replace
 from decimal import Decimal
+from time import sleep
 from uuid import UUID, uuid4
 
 from app.domain import (
@@ -43,6 +44,7 @@ class TransferService:
             if source.balance < normalized_amount:
                 raise InsufficientFunds("source wallet has insufficient funds")
 
+            sleep(0.01)  # Simulate repository/network latency outside a transaction.
             transfer = Transfer(
                 id=uuid4(),
                 actor_id=actor_id,
